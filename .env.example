# Loveline's Supabase project → Project Settings → API (or "Connect")
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional: protects /api/keep-alive. Vercel sends it automatically to cron jobs.
CRON_SECRET=

# Booking alerts (Loveline's Resend account → API Keys, sending access)
RESEND_API_KEY=re_...
# Optional: who gets the alerts (comma-separate for more) and who they're from
BOOKINGS_EMAIL=lovelinesvo@gmail.com
BOOKINGS_FROM=Boses Filipina <bookings@lovelineloverez.com>
